{
    "name": "gonghua",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:web": "pnpm --filter @gonghua/web dev",
        "dev:server": "pnpm --filter @gonghua/server dev",
        "dev:server:db": "pnpm --filter @gonghua/server dev",
        "db:health": "pnpm --filter @gonghua/server run db:health",
        "db:studio": "pnpm --filter @gonghua/server run db:studio",
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "lint": "pnpm -r lint",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "latest",
        "eslint": "latest",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.5",
        "globals": "^17.11.0",
        "prettier": "latest",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.69.0",
        "vitest": "latest"
    }
}
