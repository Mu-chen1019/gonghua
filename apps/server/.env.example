# PostgreSQL 开发库连接串示例，不要在仓库中提交真实账号或密码。
DATABASE_URL="postgresql://gonghua_user:gonghua_password@localhost:5432/gonghua_dev?schema=public"

# Prisma 迁移使用的影子库连接串示例。
SHADOW_DATABASE_URL="postgresql://gonghua_user:gonghua_password@localhost:5432/gonghua_shadow?schema=public"

# 可选测试库连接串示例，供后续自动化测试或隔离验证使用。
TEST_DATABASE_URL="postgresql://gonghua_user:gonghua_password@localhost:5432/gonghua_test?schema=public"

# 开启后 Prisma 会输出 SQL 查询日志，仅建议本地调试使用。
DB_LOG_QUERIES="false"
