        "@vitejs/plugin-react": "latest",
        "framer-motion": "latest",
        "lucide-react": "latest",
        "react": "latest",
        "react-dom": "latest",
        "react-router-dom": "latest",
        "zustand": "latest"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "autoprefixer": "latest",
        "postcss": "latest",
        "tailwindcss": "latest",
        "typescript": "^5.9.3",
        "vite": "latest",
        "vitest": "latest"
